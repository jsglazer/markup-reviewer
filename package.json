{
	"name": "markup-reviewer",
	"version": "1.0.19",
	"description": "Read handwritten pen markup from a scanned PDF with Claude and apply each edit to the source note from an Obsidian side panel",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"check-types": "tsc --noEmit --skipLibCheck",
		"lint": "eslint src tests",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"claude",
		"markup",
		"handwriting",
		"pdf",
		"review"
	],
	"author": "Josh Glazer",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.3",
		"builtin-modules": "^5.2.0",
		"esbuild": "0.28.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "latest",
		"prettier": "^3.8.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "~5.0.5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "~1.12.0",
		"diff": "^8.0.4"
	}
}
